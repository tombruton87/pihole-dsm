# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8089                       # Pi-hole's web page
DNS_PORT=53                          # DNS for your network — 53, the standard port
LAN_IP=192.168.1.10                  # point your router's DNS (or your devices) at this
TZ=Europe/London
APP_URL=http://192.168.1.10:8089
SSL_PROXY=0
PH_IMAGE=pihole/pihole:latest
PH_APP=…                             # the package's app password (Pi-hole's own kind) — root-only file
UPSTREAM=cloudflare                  # cloudflare | quad9 | google | custom
CUSTOM_DNS=                          # with custom: up to two addresses, + separated
DSM_ALERTS=1                         # a DSM notification when blocking has been off for an hour with no timer
TLS=off                              # dsm | self | off
TLS_SOURCE=off
INNER_PORT=80                        # 443 when HTTPS is on
TLS_PEM=/etc/pihole/tls.pem          # Pi-hole's own until HTTPS uses DSM's or the package's certificate
